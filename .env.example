# TAPTAP 환경변수 템플릿
# 이 파일을 복사해 .env 를 만들고 값을 채운다:  cp .env.example .env
# .env 는 절대 깃에 올리지 않는다.

# ── 서버 ──
PORT=3000
# 로컬: 비워두면 http://localhost:3000 사용
# 서버: https://jnutaptap.duckdns.org
BASE_URL=
# 비워두면 같은 출처만 허용 (보통 비워둔다)
CORS_ORIGIN=

# ── DB ──
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=rhythm_game

# ── JWT ──
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── 카카오 로그인 ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# ── 구글 로그인 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── 프론트 주소 (로그인 후 돌아갈 곳) ──
FRONTEND_URL=